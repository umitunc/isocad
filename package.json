{
  "name": "isocad-webgl-pdf",
  "version": "1.0.1",
  "description": "IsoCad — Browser-native WebGL2 CAD & Industrial Piping Isometric PDF Editor with automated MTO, Weld Log, Cut List extraction and bidirectional API sync.",
  "keywords": [
    "isocad",
    "webgl-cad",
    "piping-isometric",
    "pdf-editor",
    "mto-extractor",
    "weld-log",
    "as-built",
    "autocad-alternative"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist-lib/isocad.cdn.js",
  "module": "./dist-lib/isocad.es.js",
  "unpkg": "./dist-lib/isocad.cdn.js",
  "jsdelivr": "./dist-lib/isocad.cdn.js",
  "exports": {
    ".": {
      "import": "./dist-lib/isocad.es.js",
      "require": "./dist-lib/isocad.cdn.js"
    },
    "./style.css": "./dist-lib/isocad.css",
    "./cdn": "./dist-lib/isocad.cdn.js"
  },
  "files": [
    "dist",
    "dist-lib",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lib": "vite build --config vite.lib.config.ts && vite build --config vite.cdn.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "earcut": "^3.0.1",
    "exceljs": "^4.4.0",
    "gl-matrix": "^3.4.3",
    "idb": "^8.0.2",
    "lucide-react": "^0.475.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4",
    "rbush": "^4.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.2.0",
    "sheetgl": "^2.2.6",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/earcut": "^3.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/rbush": "^4.0.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}
